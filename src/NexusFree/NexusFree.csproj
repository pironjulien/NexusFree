<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>1.3.4</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NexusFree</AssemblyName>
    <RootNamespace>NexusFree</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Both release architectures in the restore graph, so packages.lock.json covers the release publishes. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- The package below is pinned on purpose (see there): its "delete explicit reference" notice is answered. -->
    <SuppressILLinkExplicitPackageReferenceWarning>true</SuppressILLinkExplicitPackageReferenceWarning>
  </PropertyGroup>
  <ItemGroup>
    <!-- The trimmer's tasks, which the self-contained single-file publish adds: pinned like any package
         (packages.lock.json, Dependabot); left implicit, their version would follow the .NET SDK of the machine and
         break the locked restore whenever the CI's SDK moves. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NexusFree.Tests" />
  </ItemGroup>
</Project>
